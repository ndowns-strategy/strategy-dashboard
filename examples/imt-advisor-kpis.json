{
 "name": "IMT Advisor Sales and Opportunity Performance",
 "project_id": "1FC5A43B374C963CC773C285DF86E2F6",
 "dataset": {
  "id": "C4AF3C5600794076AFA4BBE8EC09F4AC",
  "name": "IMT Advisor Sales and Opportunity Performance Model"
 },
 "overwrite": true,
 "background": "#F3F5F8",
 "derived_metrics": [
  {
   "name": "Active Producers",
   "formula": "Sum(If([Producer Category]@ID = \"Active Producer\", 1, 0))",
   "format": "#,##0"
  },
  {
   "name": "Not Active Producers",
   "formula": "[Advisor Count] - Sum(If([Producer Category]@ID = \"Active Producer\", 1, 0))",
   "format": "#,##0"
  },
  {
   "name": "Wholesaler Count",
   "formula": "Count<Distinct=True>([External Wholesaler Name])",
   "format": "#,##0"
  },
  {
   "name": "YTD Sales Change",
   "formula": "([Year To Date Total Sales Amount] - [Prior Year To Date Total Sales Amount]) / [Prior Year To Date Total Sales Amount]",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "Avg Ticket YTD",
   "formula": "[Year To Date Total Sales Amount] / [Year To Date New Ticket Count]",
   "format": "$#,##0,\"K\""
  },
  {
   "name": "Advisor Rank",
   "formula": "Rank<ASC=False>([Year To Date Total Sales Amount])",
   "format": "#,##0"
  }
 ],
 "number_formats": {
  "Year To Date Total Sales Amount": "$#,##0.0,,\"M\"",
  "Prior Year To Date Total Sales Amount": "$#,##0.0,,\"M\"",
  "Rolling 12 Month Total Sales Amount": "$#,##0.0,,\"M\"",
  "Prior Fiscal Year Total Sales Amount": "$#,##0.0,,\"M\"",
  "Rolling 12 Month Total Annuity Opportunity Amount": "$#,##0.0,,\"M\"",
  "Year To Date External Spend Amount": "$#,##0,\"K\""
 },
