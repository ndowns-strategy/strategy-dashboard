{
 "name": "IMT Advisor Sales and Opportunity Performance (v3)",
 "project_id": "1FC5A43B374C963CC773C285DF86E2F6",
 "dataset": {
  "id": "C4AF3C5600794076AFA4BBE8EC09F4AC",
  "name": "IMT Advisor Sales and Opportunity Performance Model"
 },
 "overwrite": true,
 "auto_summary": true,
 "hover_highlight": false,
 "background": "#F4F6FA",
 "derived_metrics": [
  {
   "name": "YTD Sales Change",
   "formula": "([Year To Date Total Sales Amount] / [Prior Year To Date Total Sales Amount]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "Active Producers",
   "formula": "Sum(If([Producer Category]@ID = \"Active Producer\", 1, 0))",
   "format": "#,##0"
  },
  {
   "name": "Lapsed or Prospect Advisors",
   "formula": "Sum(If([Producer Category]@ID <> \"Active Producer\", 1, 0))",
   "format": "#,##0"
  },
  {
   "name": "Average Ticket",
   "formula": "[Year To Date Total Sales Amount] / [Year To Date New Ticket Count]",
   "format": "$#,##0.0,\"K\""
  },
  {
   "name": "Year to date",
   "formula": "Sum(If([Producer Category]@ID = \"Active Producer\", [Year To Date Total Sales Amount], 0)) / 1000000",
   "format": "$#,##0.0\"M\""
  },
  {
   "name": "Prior year to date",
   "formula": "Sum(If([Producer Category]@ID = \"Active Producer\", [Prior Year To Date Total Sales Amount], 0)) / 1000000",
   "format": "$#,##0.0\"M\""
  },
  {
   "name": "Level Change",
   "formula": "([Year to date] / [Prior year to date]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "FIA Change",
   "formula": "([Year To Date Fixed Indexed Annuity Sales Amount] / [Prior Year To Date FIA Sales Amount]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "LIA Change",
   "formula": "([Year To Date Lifetime Income Annuity Sales Amount] / [Prior Year To Date Lifetime Income Annuity Sales Amount]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "VA Change",
   "formula": "([Year To Date Variable Annuity Sales Amount] / [Prior Year To Date Variable Annuity Sales Amount]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "FA Change",
   "formula": "([Year To Date Fixed Annuity Sales Amount] / [Prior Year To Date Fixed Annuity Sales Amount]) - 1",
   "format": "+0.0%;-0.0%"
  },
  {
   "name": "Share of Opportunity",
   "formula": "[Rolling 12 Month Total Annuity Opportunity Amount] / Sum([Rolling 12 Month Total Annuity Opportunity Amount]){}",
   "format": "0%"
  },
  {
   "name": "Opportunity per Advisor",
   "formula": "[Rolling 12 Month Total Annuity Opportunity Amount] / [Advisor Count]",
   "format": "$#,##0.0,,\"M\""
  },
  {
   "name": "Sales per Activity",
   "formula": "[Year To Date Total Sales Amount] / [Year To Date External Activity Count]",
   "format": "$#,##0,\"K\""
  },
  {
   "name": "Advisor Rank",
   "formula": "Rank<ASC=False>([Year To Date Total Sales Amount])",
   "format": "#,##0"
  },
  {
   "name": "Has Prior Sales",
   "formula": "If(NullToZero([Prior Year To Date Total Sales Amount]) > 0, 1, 0)",
   "format": "0"
  }
 ],
 "number_formats": [
  {
   "metrics": [
    "Year To Date Total Sales Amount",
