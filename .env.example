# Copy to .env (gitignored) and fill in. Never commit .env.
SDC_BASE_URL=https://studio.strategy.com/MicroStrategyLibrary
SDC_PROJECT_ID=607F0D20E84F2EF50271148D7D409484

# Sign-in is asked up front (python3 -m sdc login, or the first command with no session).
# Optional default answer: sso | standard | ldap
#SDC_AUTH=sso

# Optional defaults for standard / ldap sign-in. With SDC_AUTH=standard or ldap and both set, scripts run
# without a terminal sign in with them without asking.
#SDC_USERNAME=
#SDC_PASSWORD=
